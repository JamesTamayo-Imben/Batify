# Client (.env.local) — safe to expose, these are public by design
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional: per-placement AdSense ad unit IDs (create 3 display units in AdSense)
VITE_ADSENSE_SLOT_HOME=0000000001
VITE_ADSENSE_SLOT_CREATE=0000000002
VITE_ADSENSE_SLOT_PUBLIC=0000000003

# NOTE: server secrets (TURNSTILE_SECRET_KEY, ADMIN_SECRET) are NOT set here.
# Use `supabase secrets set ...` — see README.md.
